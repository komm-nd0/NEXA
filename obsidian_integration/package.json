{
  "name": "nexa-obsidian-integration",
  "version": "1.0.0",
  "description": "NEXA-Obsidian Integration Plugin for penetration testing documentation",
  "main": "nexa_obsidian_plugin.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "nexa",
    "pentest",
    "reconnaissance",
    "security",
    "enumeration"
  ],
  "author": "NEXA Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "obsidian": "latest"
  }
}
